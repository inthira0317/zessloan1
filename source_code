      cl_salv_table=>factory(
        IMPORTING
          r_salv_table = gr_alv
        CHANGING
*
          t_table      = gt_output ).


*---------------------------------------------------------------------*
* OPTIMIZE COLUMNS
*---------------------------------------------------------------------*

      lo_columns = gr_alv->get_columns( ).

      lo_columns->set_optimize( abap_true ).

*---------------------------------------------------------------------*
* ENABLE ALV FUNCTIONS
*---------------------------------------------------------------------*

      gr_alv->get_functions( )->set_all( abap_true ).

*---------------------------------------------------------------------*
* SET COLUMN HEADINGS
*---------------------------------------------------------------------*

      TRY.

          lo_column ?= lo_columns->get_column( 'PERNR' ).
          lo_column->set_short_text( 'PERNR' ).
          lo_column->set_medium_text( 'Employee No' ).
          lo_column->set_long_text( 'Employee Number' ).

          lo_column ?= lo_columns->get_column( 'SUBTY' ).
          lo_column->set_short_text( 'Subtype' ).
          lo_column->set_medium_text( 'Loan Subtype' ).
          lo_column->set_long_text( 'Loan Subtype' ).

          lo_column ?= lo_columns->get_column( 'OBJPS' ).
          lo_column->set_short_text( 'Sequence' ).
          lo_column->set_medium_text( 'Sequence No' ).
          lo_column->set_long_text( 'Loan Sequence Number' ).

          lo_column ?= lo_columns->get_column( 'DATBW' ).
          lo_column->set_short_text( 'Approved' ).
          lo_column->set_medium_text( 'Approved Date' ).
          lo_column->set_long_text( 'Loan Approved Date' ).

          lo_column ?= lo_columns->get_column( 'DARBT' ).
          lo_column->set_short_text( 'Loan Amt' ).
          lo_column->set_medium_text( 'Loan Amount' ).
          lo_column->set_long_text( 'Loan Amount' ).

          lo_column ?= lo_columns->get_column( 'OPELO' ).
          lo_column->set_short_text( 'Balance' ).
          lo_column->set_medium_text( 'Loan Balance' ).
          lo_column->set_long_text( 'Loan Balance' ).

          lo_column ?= lo_columns->get_column( 'ACCINR' ).
          lo_column->set_short_text( 'Acc.Int' ).
          lo_column->set_medium_text( 'Accrued Interest' ).
          lo_column->set_long_text( 'Accrued Interest' ).

          lo_column ?= lo_columns->get_column( 'OPEN_INT' ).
          lo_column->set_short_text( 'Open Int' ).
          lo_column->set_medium_text( 'Opening Interest' ).
          lo_column->set_long_text( 'Opening Interest ' ).

          lo_column ?= lo_columns->get_column( 'TOTAL' ).
          lo_column->set_short_text( 'Total' ).
          lo_column->set_medium_text( 'Total Balance' ).
          lo_column->set_long_text(
            'Total Balance Including Interest' ).

        CATCH cx_salv_not_found.
      ENDTRY.

*---------------------------------------------------------------------*
* DISPLAY ALV
*---------------------------------------------------------------------*

      gr_alv->display( ).

    CATCH cx_salv_msg.

      MESSAGE 'Error displaying ALV'
        TYPE 'S' DISPLAY LIKE 'E'.

  ENDTRY.

ENDFORM.
